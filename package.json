{
  "name": "github-sign-in",
  "displayName": "GitHub Sign In",
  "description": "Sign in to GitHub from VS Code using GitHub CLI.",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.140.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "extensionDependencies": [
    "vscode.git"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "github-sign-in.signIn",
        "title": "GitHub CLI: Sign In"
      },
      {
        "command": "github-sign-in.switchAccount",
        "title": "GitHub CLI: Switch Account"
      },
      {
        "command": "github-sign-in.refresh",
        "title": "GitHub CLI: Refresh Status"
      },
      {
        "command": "github-sign-in.syncWorkspace",
        "title": "Git: Sync Workspace Repositories"
      }
    ],
    "configuration": {
      "title": "GitHub Sign In",
      "properties": {
        "github-sign-in.host": {
          "type": "string",
          "default": "github.com",
          "description": "GitHub or GitHub Enterprise hostname used by GitHub CLI."
        },
        "github-sign-in.syncOnLaunch": {
          "type": "boolean",
          "default": true,
          "description": "Synchronize open Git repositories when VS Code launches and the configured GitHub CLI account is authenticated."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.140.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
